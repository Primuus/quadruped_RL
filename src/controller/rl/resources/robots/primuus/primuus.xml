<mujoco model="primuus">
  <!--由 urdf/primuus.urdf 转换；机械数据修改后须同步本文件并复核，不使用 Go2 的几何或关节零位。-->
  <compiler angle="radian" autolimits="true" fusestatic="false" inertiafromgeom="false" />
  <!--关节范围沿用机械交付的 URDF；自碰撞必须由接触处理，不能通过收紧限位代替。-->
  <option timestep="0.00025" integrator="implicitfast" gravity="0 0 -9.81">
    <!--相邻运动刚体也检测碰撞；仅用下方几何掩码排除正常的电机安装接触。-->
    <flag filterparent="disable" />
  </option>
  <default>
    <default class="primuus">
      <!--摩擦为当前平地仿真假设；不表示实物辨识结果。-->
      <!--0.25 ms 步长配合 0.5 ms 接触响应，避免快速折膝时跨过薄壁；不改变几何限位。-->
      <geom rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" friction="0.8 0.005 0.0001" condim="3" conaffinity="1023" margin="0.001" solref="0.0005 1" solimp="0.99 0.999 0.001" />
      <!--12 个理想关节力矩执行器：ctrl 与 force 均为关节端 N m，统一限矩 23.7。-->
      <motor ctrllimited="true" ctrlrange="-23.7 23.7" forcelimited="true" forcerange="-23.7 23.7" gear="1" />
      <default class="primuus_visual">
        <geom contype="0" conaffinity="0" group="2" density="0" />
      </default>
      <default class="primuus_collision">
        <geom group="3" />
      </default>
    </default>
  </default>
  <!--碰撞位：通用=1，机身=2，FL/FR/RL/RR 髋=4/8/16/32，腿电机=64/128/256/512。-->
  <!--双方均拒绝对方类型才排除碰撞；其余类型全部允许。固定足端、载体与小腿属于同一焊接组。-->
