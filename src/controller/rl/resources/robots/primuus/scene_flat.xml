<mujoco model="primuus flat scene">
  <include file="primuus.xml" />

  <statistic center="0 0 0.15" extent="0.8" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.2 0.25 1" />
    <global azimuth="135" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.4 0.5" rgb2="0.05 0.07 0.1"
      width="512" height="3072" />
    <texture type="2d" name="primuus_ground" builtin="checker" mark="edge"
      rgb1="0.22 0.26 0.3" rgb2="0.14 0.18 0.2" markrgb="0.7 0.75 0.8" width="300" height="300" />
    <material name="primuus_ground" texture="primuus_ground" texuniform="true"
      texrepeat="5 5" reflectance="0.1" />
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" />
    <!-- 摩擦沿用当前平地模型测试的假设值；地面不属于机器人机械模型。 -->
    <geom name="floor" type="plane" size="0 0 0.05" material="primuus_ground"
      friction="0.8 0.005 0.0001" condim="3" />
  </worldbody>
</mujoco>
